# Public browser configuration - set this to the deployed FastAPI API origin.
VITE_API_URL=http://localhost:8001

# API runtime
APP_ENV=development
DATABASE_URL=sqlite:///./byzantium_autoclaims.db
UPLOAD_DIR=uploads
POLICY_DIR=policies
# Vercel always runs as a synthetic, read-only showcase. Do not override this for live claims.
BYZANTIUM_DEMO_MODE=false
# Local prepared demonstrations may return labelled mock VideoDB evidence, never final decisions.
BYZANTIUM_ALLOW_SYNTHETIC_EVIDENCE=false
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Provider credentials - configure only in the API runtime, never in Vite.
VIDEODB_API_KEY=
TERMINAL3_API_KEY=
TERMINAL3_DID=
TOKENROUTER_API_KEY=
KIMI_API_KEY=
ANTHROPIC_API_KEY=
DAYTONA_API_KEY=
NOSANA_API_KEY=
SENSENOVA_API_KEY=
MYINFO_CLIENT_ID=
